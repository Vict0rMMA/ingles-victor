# ---------------------------------------------------------------
# AI English Coach - variables de entorno
# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio.
# ---------------------------------------------------------------

# Obligatoria. API key de Google AI Studio: https://aistudio.google.com/apikey
# Solo se usa en el servidor (route handlers). Nunca se expone al navegador.
GEMINI_API_KEY=

# ---------------------------------------------------------------
# Modelos (opcionales). Si los dejas vacios se usan los valores por
# defecto del codigo, que ya incluyen una cadena de respaldo automatica.
# ---------------------------------------------------------------

# Modelo de la conversacion hablada. Aqui manda la latencia: flash-lite
# responde en ~1.2s y corrige igual de bien que los modelos grandes.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Modelo para ejercicios y analisis, donde importa mas la calidad que la
# velocidad. gemini-3.8-flash es mas potente pero devuelve 503 a menudo.
GEMINI_TEXT_MODEL=gemini-3.5-flash

# Modelo de voz en tiempo real (Live API, audio bidireccional).
GEMINI_LIVE_MODEL=gemini-3.8-live

# Modelo de texto a voz. El lite es mas rapido (~3s frente a ~5s) y no
# agota la cuota del plan gratuito tan rapido como gemini-3.8-flash-tts.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# ---------------------------------------------------------------
# Control de consumo (opcionales)
# ---------------------------------------------------------------

# Peticiones permitidas por ventana de tiempo y por IP.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Minutos de vida del token efimero de Gemini Live.
LIVE_TOKEN_MINUTES=20
